<http://purl.org/pionera/daimo#> rdf:type owl:Ontology ;
                               rdfs:label "DAIMO ontology"@en ;
                               rdfs:comment "Ontology for representing AI models as governed assets in data spaces."@en ;
                               dcterms:title "DAIMO: An ontology for managing AI models in data spaces"@en ;
                               dcterms:description "DAIMO models AI models as governed assets in data spaces and connects publication metadata, policy constraints, invocation contracts, runtime requirements, execution traces, evaluation contexts, audit evidence, and reproducibility evidence."@en ;
                               dcterms:creator daimo:Edmundo ,
                                               daimo:Jiayun ;
                               dcterms:issued "2026-04-03"^^xsd:date ;
                               dcterms:modified "2026-04-04"^^xsd:date ;
                               owl:versionIRI <http://purl.org/pionera/daimo/1.0.0> ;
                               owl:versionInfo "1.0.0" ;
                               vann:preferredNamespacePrefix "daimo" ;
                               vann:preferredNamespaceUri "http://purl.org/pionera/daimo#" ;
                               mod:createdWith <https://chowlk.linkeddata.es/> .

#################################################################
#    Annotation properties
#################################################################

###  http://xmlns.com/foaf/0.1/mbox
foaf:mbox rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
foaf:name rdf:type owl:AnnotationProperty .


###  https://w3id.org/mod#createdWith
mod:createdWith rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .

#################################################################
#    Individuals
#################################################################


###  http://purl.org/pionera/daimo#
<http://purl.org/pionera/daimo#> rdf:type owl:NamedIndividual ;
                              dcterms:creator daimo:Edmundo ,
                                              daimo:Jiayun .


###  http://purl.org/pionera/daimo#Edmundo
daimo:Edmundo rdf:type owl:NamedIndividual ,
                      foaf:Person ;
             foaf:mbox <mailto:edmundo.mori.orrillo@upm.es> ;
             foaf:name "Edmundo de Elvira Mori Orrillo" .


###  http://purl.org/pionera/daimo#Jiayun
daimo:Jiayun rdf:type owl:NamedIndividual ,
                     foaf:Person ;
            foaf:mbox <mailto:jiayun.liu@upm.es> ;
            foaf:name "Jiayun Liu" .

#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:ObjectProperty ;
                rdfs:label "creator" .


###  http://purl.org/pionera/daimo#hasEvaluation
daimo:hasEvaluation rdf:type owl:ObjectProperty ;
                    rdfs:domain daimo:Model ;
                    rdfs:range mls:ModelEvaluation ;
                    rdfs:label "has evaluation" .


###  http://purl.org/pionera/daimo#hasAuditArtifact
daimo:hasAuditArtifact rdf:type owl:ObjectProperty ;
                       rdfs:domain mls:Run ;
                       rdfs:range daimo:AuditArtifact ;
                       rdfs:label "has audit artifact" .


###  http://purl.org/pionera/daimo#hasEvaluationContext
daimo:hasEvaluationContext rdf:type owl:ObjectProperty ;
                           rdfs:domain mls:ModelEvaluation ;
                           rdfs:range daimo:EvaluationContext ;
                           rdfs:label "has evaluation context" .


###  http://purl.org/pionera/daimo#hasIOContract
daimo:hasIOContract rdf:type owl:ObjectProperty ;
                    rdfs:domain daimo:Model ;
                    rdfs:range daimo:IOContract ;
                    rdfs:label "has IO contract" .


###  http://purl.org/pionera/daimo#hasImplementation
daimo:hasImplementation rdf:type owl:ObjectProperty ;
                        rdfs:domain daimo:Model ;
                        rdfs:range mls:Implementation ;
                        rdfs:label "has implementation" .


###  http://purl.org/pionera/daimo#hasRuntimeProfile
daimo:hasRuntimeProfile rdf:type owl:ObjectProperty ;
                        rdfs:domain mls:Implementation ;
                        rdfs:range daimo:RuntimeProfile ;
                        rdfs:label "has runtime profile" .


###  http://purl.org/pionera/daimo#hasReproducibilityArtifact
daimo:hasReproducibilityArtifact rdf:type owl:ObjectProperty ;
                                 rdfs:domain mls:ModelEvaluation ;
                                 rdfs:range daimo:ReproducibilityArtifact ;
                                 rdfs:label "has reproducibility artifact" .


###  http://www.w3.org/ns/dcat#accessService
dcat:accessService rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:Distribution ;
                   rdfs:range dcat:DataService ;
                   rdfs:label "access service" .


###  http://www.w3.org/ns/dcat#distribution
dcat:distribution rdf:type owl:ObjectProperty ;
                  rdfs:domain dcat:Dataset ;
                  rdfs:range dcat:Distribution ;
                  rdfs:label "distribution" .


###  http://www.w3.org/ns/dcat#servesDataset
dcat:servesDataset rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:DataService ;
                   rdfs:range dcat:Dataset ;
                   rdfs:label "serves dataset" .


###  http://www.w3.org/ns/mls#SourceCode
mls:SourceCode rdf:type owl:ObjectProperty ;
               rdfs:domain sd:Software ;
               rdfs:range sd:SourceCode ;
               rdfs:label "source code" .


###  http://www.w3.org/ns/mls#executes
mls:executes rdf:type owl:ObjectProperty ;
             rdfs:domain mls:Run ;
             rdfs:range mls:Implementation ;
             rdfs:label "executes" .


###  http://www.w3.org/ns/mls#hasHyperParameter
mls:hasHyperParameter rdf:type owl:ObjectProperty ;
                      rdfs:domain mls:Implementation ;
                      rdfs:range mls:HyperParameter ;
                      rdfs:label "has hyper parameter" .


###  http://www.w3.org/ns/mls#hasOutput
mls:hasOutput rdf:type owl:ObjectProperty ;
              rdfs:domain mls:Run ;
              rdfs:label "has output" .


###  http://www.w3.org/ns/mls#hasPart
mls:hasPart rdf:type owl:ObjectProperty ;
            rdfs:label "has part" .


###  http://www.w3.org/ns/mls#hasQuality
mls:hasQuality rdf:type owl:ObjectProperty ;
               rdfs:domain mls:HyperParameter ;
               rdfs:range mlso:HyperParameterCharacteristic ;
               rdfs:label "has quality" .


###  http://www.w3.org/ns/mls#implements
mls:implements rdf:type owl:ObjectProperty ;
               rdfs:domain mls:Implementation ;
               rdfs:range mls:Algorithm ;
               rdfs:label "implements" .


###  http://www.w3.org/ns/mls#realizes
mls:realizes rdf:type owl:ObjectProperty ;
             rdfs:domain mls:Run ;
             rdfs:range mls:Algorithm ;
             rdfs:label "realizes" .


###  http://www.w3.org/ns/mls#specifiedBy
mls:specifiedBy rdf:type owl:ObjectProperty ;
                rdfs:label "specified by" .


###  http://www.w3.org/ns/odrl/2/assigneeOf
odrl:assigneeOf rdf:type owl:ObjectProperty ;
                rdfs:domain odrl:Party ;
                rdfs:range odrl:Offer ;
                rdfs:label "assignee of" .


###  http://www.w3.org/ns/odrl/2/assignerOf
odrl:assignerOf rdf:type owl:ObjectProperty ;
                rdfs:domain odrl:Party ;
                rdfs:range odrl:Offer ;
                rdfs:label "assigner of" .


###  http://www.w3.org/ns/odrl/2/hasPolicy
odrl:hasPolicy rdf:type owl:ObjectProperty ;
