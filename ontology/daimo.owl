  <owl:Ontology rdf:about="http://purl.org/pionera/daimo#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">DAIMO ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Ontology for representing AI models as governed assets in data spaces.</rdfs:comment>
    <dcterms:title xml:lang="en">DAIMO: An ontology for managing AI models in data spaces</dcterms:title>
    <dcterms:description xml:lang="en">DAIMO models AI models as governed assets in data spaces and connects publication metadata, policy constraints, invocation contracts, runtime requirements, execution traces, evaluation contexts, audit evidence, and reproducibility evidence.</dcterms:description>
    <dcterms:creator>
      <owl:NamedIndividual rdf:about="http://purl.org/pionera/daimo#Edmundo">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:mbox rdf:resource="mailto:edmundo.mori.orrillo@upm.es"/>
        <foaf:name>Edmundo de Elvira Mori Orrillo</foaf:name>
      </owl:NamedIndividual>
    </dcterms:creator>
    <dcterms:creator>
      <owl:NamedIndividual rdf:about="http://purl.org/pionera/daimo#Jiayun">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <foaf:mbox rdf:resource="mailto:jiayun.liu@upm.es"/>
        <foaf:name>Jiayun Liu</foaf:name>
      </owl:NamedIndividual>
    </dcterms:creator>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-03</dcterms:issued>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-04</dcterms:modified>
    <owl:versionIRI rdf:resource="http://purl.org/pionera/daimo/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <vann:preferredNamespacePrefix>daimo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://purl.org/pionera/daimo#</vann:preferredNamespaceUri>
    <mod:createdWith rdf:resource="https://chowlk.linkeddata.es/"/>
  </owl:Ontology>
