PREFIX daimo: <http://purl.org/pionera/daimo#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?model ?version ?license
WHERE {
  ?model a daimo:Model ;
         daimo:task "Flood risk prediction" ;
         daimo:applicationDomain "Climate analytics" ;
         dcat:version ?version ;
         dcterms:license ?license .
}
ORDER BY ?model
