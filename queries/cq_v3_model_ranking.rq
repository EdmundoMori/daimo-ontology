PREFIX daimo: <http://purl.org/pionera/daimo#>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?model ?metricLabel ?metricValue
WHERE {
  ?model a daimo:Model ;
         daimo:hasEvaluation ?evaluation .
  ?evaluation mls:specifiedBy ?metric ;
              daimo:metricValue ?metricValue ;
              daimo:hasEvaluationContext ?context .
  ?context daimo:evaluationDataset "ClimateBench-v1" ;
           daimo:evaluationProtocol "Stratified holdout 80/20 with fixed seed 42" .
  OPTIONAL { ?metric rdfs:label ?metricLabel . }
}
ORDER BY DESC(?metricValue)
