PREFIX daimo: <http://purl.org/pionera/daimo#>

SELECT ?model ?evaluation ?dataset ?datasetVersion ?protocol ?seed
WHERE {
  ?model a daimo:Model ;
         daimo:hasEvaluation ?evaluation .
  ?evaluation daimo:hasEvaluationContext ?context .
  ?context daimo:evaluationDataset ?dataset ;
           daimo:evaluationDatasetVersion ?datasetVersion ;
           daimo:randomSeed ?seed ;
           daimo:evaluationProtocol ?protocol .
}
ORDER BY ?model
